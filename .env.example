DATABASE_URL=postgresql://postgres:postgres@localhost:5432/scheduler
SCHEDULER_PUBLIC_URL=http://localhost:3008
SCHEDULER_ADMIN_TOKEN=
SCHEDULER_TOKEN_KEY=
CRON_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exact parent origins allowed to frame /embed/* (set at build time):
SCHEDULER_EMBED_ORIGINS=http://localhost:3000
# Optional server-managed alternative to Connect Google:
# GOOGLE_REFRESH_TOKEN=
# SCHEDULER_CALENDAR_ID=primary
# SCHEDULER_EXTRA_GUESTS=
# Optional host notification email (Google sends attendee invites):
# RESEND_API_KEY=
# RESEND_FROM=Loopin <bookings@example.com>
# SCHEDULER_HOST_EMAIL=
# ZOOM_ACCOUNT_ID=
# ZOOM_CLIENT_ID=
# ZOOM_CLIENT_SECRET=
# ZOOM_HOST_EMAIL=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# SCHEDULER_WEBHOOK_URL=https://your-customer-system.example/scheduler-events
# SCHEDULER_WEBHOOK_SECRET=

# Docker: set false when your host runs migrations as a separate release job.
# RUN_MIGRATIONS=false
